# Vibe Coding Key — handheld (ESP32-S3)
# Flash size is NOT fixed here — pick a PIO env / overlay:
#   sdkconfig.flash.4mb  | 8mb | 16mb   (see docs/flashing.md §4.0)
# Default PIO env "esp32s3" uses 8mb (Controller-RevB N8R2). Upload can also
# auto-detect via tools/flash_handheld.sh.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESPNOW_WIFI_STA_ENABLED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# BLE HID media mode (no classic BT on S3)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
